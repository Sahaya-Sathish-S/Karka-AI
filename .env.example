# Karka AI / OpenRouter configuration
# Never put a real API key in frontend JavaScript or commit it to a public repository.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openrouter/free
# Optional comma-separated fallbacks. Leave empty to avoid unexpected paid usage.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_URL=https://karka.ai
OPENROUTER_SITE_NAME=Karka AI
# Anti-spam / cost-control settings
KARKA_CHAT_CACHE_TTL=900
KARKA_CHAT_MIN_INTERVAL=2
KARKA_CHAT_RATE_MAX=10
# Flask
SECRET_KEY=change-me-to-a-long-random-string
# FLASK_DEBUG=1
# Karka AI location (optional overrides)
KARKA_MAPS_URL=https://maps.app.goo.gl/4P1jj6hAVpHMSwpWA?g_st=aw
# KARKA_MAPS_EMBED_URL=<paste the src="..." from Google Maps -> Share -> Embed a map>
